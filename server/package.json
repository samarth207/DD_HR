{
  "name": "hr-portal-server",
  "version": "1.0.0",
  "description": "HR Portal Backend Server with MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:salary-period": "node scripts/migrate-salary-period-fields.js",
    "migrate:admission-fees": "node scripts/migrate-admission-fee-management.js",
    "rollback:admission-fees": "node scripts/rollback-admission-fee-management-migration.js",
    "benchmark:admissions": "node scripts/benchmark-admission-queries.js",
    "benchmark:admissions:local": "node scripts/benchmark-admission-queries-local.js",
    "test:email": "node scripts/test-email.js",
    "test:qa": "node -e \"require('fs').mkdirSync('testing/reports',{recursive:true})\" && jest --runInBand --config jest.qa.config.js --json --outputFile=testing/reports/jest-results.json && node scripts/generate-qa-html-report.js",
    "test:e2e": "jest --runInBand --config jest.e2e.config.js",
    "test:automation": "npm run test:e2e",
    "test:e2e:report": "cross-env PERSIST_TEST_REPORTS=true jest --runInBand --config jest.e2e.config.js",
    "test:case:new": "node scripts/generate-test-case.js"
  },
  "keywords": [
    "hr",
    "mongodb",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.2.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "sanitize-html": "^2.17.7",
    "validator": "^13.15.35",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  }
}
