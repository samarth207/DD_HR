# MongoDB settings
MONGODB_URI=
DB_NAME=

# Security settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development

# SMTP settings for email notifications
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=hr@degreedrishti.com
MAIL_FROM_NAME="DegreeDrishti HR"

# Incoming mail settings (reference only; not used by backend notifications)
IMAP_HOST=mail.degreedrishti.com
IMAP_PORT=993
POP3_HOST=mail.degreedrishti.com
POP3_PORT=995
